{
  "expo": {
    "name": "Jobba the Hunt",
    "slug": "jobba-the-hunt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stefankuburovic.jobbathehunt"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05060A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stefankuburovic.jobbathehunt"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Jobba the Hunt",
      "shortName": "Jobba",
      "backgroundColor": "#05060A",
      "themeColor": "#05060A",
      "description": "Job postings from eight public boards in one feed, with an application tracker."
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#05060A",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Jobba the Hunt adds your interviews to your calendar so you get a reminder before each one."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/jobba-the-hunt"
    }
  }
}